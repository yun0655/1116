rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny: only the explicitly matched, owner-scoped library records
    // below are accessible.
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection path: users/{userId}/libraries
    // Document ID: application-generated library record ID (immutable path ID)
    // Fields (all required; no password or UID fields are stored):
    //   - name: string, 1..120 characters - library display name
    //   - url: string, valid http(s) URL shape, 1..2048 characters - sign-in/catalog URL
    //   - account: string, 0..200 characters - account-format hint only
    //   - hint: string, 0..1000 characters - personal reminder, never a password
    // Access: only the authenticated owner of {userId} may read or mutate these
    // documents. The application reads the user's own libraries subcollection.
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Library ownership is encoded in the path, not in a client-writable field.
    // These helpers therefore accept documents with no UID field and reject a
    // mismatched UID if the schema is ever changed to include one.
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function validString(value, minLength, maxLength) {
      return value is string &&
        value.size() >= minLength &&
        value.size() <= maxLength;
    }

    function isValidLibrary(data) {
      return data is map &&
        data.keys().hasAll(['name', 'url', 'account', 'hint']) &&
        data.keys().hasOnly(['name', 'url', 'account', 'hint']) &&
        validString(data.name, 1, 120) &&
        validString(data.url, 1, 2048) &&
        data.url.matches('^https?://[^ /?#]+([/?#].*)?$') &&
        validString(data.account, 0, 200) &&
        validString(data.hint, 0, 1000);
    }

    // Users can access only their own library collection. Requiring the same
    // validator for creates and updates prevents malformed or oversized data
    // from entering or later corrupting the collection.
    match /users/{userId}/libraries/{libraryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        uidUnchanged() &&
        isValidLibrary(request.resource.data);
      allow update: if isOwner(userId) &&
        uidNotModified() &&
        isValidLibrary(request.resource.data);
      allow delete: if isOwner(userId);
    }
  }
}
